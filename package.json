{
	"name": "tree-sitter-ldap-schema",
	"version": "0.1.0",
	"description": "Tree-sitter grammar for OpenLDAP / RFC 4512 LDAP schema files",
	"keywords": [
		"parser",
		"tree-sitter",
		"ldap",
		"openldap",
		"schema"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/tree-sitter-ldap-schema.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./bindings/node/index.d.ts",
			"default": "./bindings/node/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "bindings/node",
	"types": "bindings/node",
	"files": [
		"/grammar.js",
		"/tree-sitter.json",
		"/binding.gyp",
		"/prebuilds/**",
		"/bindings/node/*",
		"/queries/*",
		"/scripts/*",
		"/src/**",
		"*.wasm"
	],
	"scripts": {
		"fmt": "dprint fmt",
		"generate": "tree-sitter generate",
		"helix:sync": "mkdir -p ~/.config/helix/runtime/queries/ldap-schema && cp queries/*.scm ~/.config/helix/runtime/queries/ldap-schema/",
		"install": "node-gyp-build",
		"postinstall": "node scripts/ensure-native.mjs",
		"prepack": "tree-sitter build --wasm",
		"prepare": "node scripts/ensure-clangd-headers.mjs",
		"setup:clangd-headers": "node scripts/ensure-clangd-headers.mjs",
		"setup:native": "node scripts/ensure-native.mjs",
		"prestart": "tree-sitter build --wasm",
		"start": "tree-sitter playground --quiet",
		"test": "node --test bindings/node/*_test.js",
		"test:bun": "bun test",
		"test:corpus": "tree-sitter test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"node-addon-api": "^8.9.0",
		"node-gyp-build": "^4.8.4"
	},
	"devDependencies": {
		"dprint": "^0.55.1",
		"prebuildify": "^6.0.1",
		"tree-sitter": "^0.25.0",
		"tree-sitter-cli": "^0.26.10",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"tree-sitter": "^0.25.0"
	},
	"peerDependenciesMeta": {
		"tree-sitter": {
			"optional": true
		}
	},
	"packageManager": "bun@1.3.14"
}
